# ──────────────────────────────────────────────────────────────────────────
# Lumina Storage Bundle — Environment Variables
#
# Copy to .env, then fill in. SECRET_KEY is REQUIRED before the app will
# serve real traffic safely.
#
# Note on AI models: API keys for chat/embedding/VLM are configured by ADMIN
# through the AI Model Config UI at runtime. There is NO env-var fallback —
# admin MUST add at least one default chat model and one default embedding
# model after first login, or chat / RAG / generator / review features will
# fail with a clear "No default AI model configured" error.
# ──────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────
APP_ENV=development

# REQUIRED. Signs every JWT token the app issues. Generate once with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Anyone who reads this string can forge a token for any user → admin
# takeover. Never commit, never paste in chat, rotate if leaked.
SECRET_KEY=your-secret-key-here
# Khóa Fernet riêng mã hóa credential trong DB (KHÁC SECRET_KEY). Sinh:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=

# JSON array of frontend origins allowed to call this API. Strict — no '*'.
# MUST be a JSON array literal (brackets required). A bare string like
# `http://localhost:5174` will crash the app at startup.
# Default includes the Vite dev server for lumina-storage-frontend (port 5174).
CORS_ORIGINS=["http://localhost:5174"]


# ── Database (PostgreSQL) ─────────────────────────────────────────────────
# POSTGRES_* are read by the postgres container in docker-compose.
# DB_* are read by the FastAPI app via pydantic-settings. Keep them in sync.
# Both blocks default to the same values; override here only if you want to
# change them.
# Compose auto-runs `CREATE EXTENSION IF NOT EXISTS unaccent;` on first boot.
POSTGRES_USER=lumina
POSTGRES_PASSWORD=lumina123
POSTGRES_DB=lumina_driver_dev

DB_HOST=localhost
DB_PORT=5433
DB_NAME=lumina_driver_dev
DB_USER=lumina
DB_PASSWORD=lumina123


# ── Redis (cache + ARQ job queue) ─────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=


# ── Qdrant (vector DB) ────────────────────────────────────────────────────
# REQUIRED. Started by docker compose (qdrant service on :6333).
# QDRANT_VECTOR_SIZE must match the embedding model admin configures
# (text-embedding-3-large = 3072, text-embedding-3-small = 1536).
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=document_chunks
QDRANT_VECTOR_SIZE=3072


# ── Document conversion ───────────────────────────────────────────────────
# Gotenberg service for office → PDF conversion.
# - Compose deploys gotenberg on host port 3000; compose overrides this to
#   http://gotenberg:3000 inside the network.
GOTENBERG_URL=http://localhost:3000


# ── Langfuse (LLM observability, optional) ────────────────────────────────
# Self-hosted or cloud. Skip if not tracing LLM calls.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=


# ── Lumina SSO (Centralized) ──────────────────────────────────────────────
# Leave empty to disable SSO. The storage backend falls back to local JWT
# (HS256) when this is empty — that's what new devs use for onboarding.
LUMINA_SSO_SERVICE_URL=


# ── Microsoft Entra (OBO path from lumina-backend) ────────────────────────
# Leave empty to disable. When set, the BE verifies Microsoft access tokens
# offline via JWKS instead of falling back to local JWT.
ENTRA_TENANT_ID=
ENTRA_DRIVER_API_AUDIENCE=
ENTRA_JWKS_CACHE_SECONDS=3600


# ── Compose port overrides (optional) ─────────────────────────────────────
# Change any of these if the default port conflicts with another service
# on your host. The change applies to `docker compose up`.
POSTGRES_PORT=5433
REDIS_PORT=6380
QDRANT_PORT=6333
GOTENBERG_PORT=3000
STORAGE_PORT=1690

# Local UID/GID for the app/worker container user (matches host user so
# mounted uploads are writable). Override if `id -u`/`id -g` differ.
LOCAL_UID=1000
LOCAL_GID=1000