# ──────────────────────────────────────────────────────────────────────────
# Lumina Storage Backend — Environment Variables
#
# Copy to .env, then fill in. Anything marked REQUIRED must be set before
# the app will start serving real traffic safely.
#
# Note on AI models: API keys for chat/embedding/VLM are configured by ADMIN
# through the AI Model Config UI at runtime. There is NO env-var fallback —
# admin MUST add at least one default chat model and one default embedding
# model after first login, or chat / RAG / generator / review features will
# fail with a clear "No default AI model configured" error.
#
# Note on upload size limit: configured per StorageConfig via the Storage
# admin UI (max_upload_size_mb in the storage config). Default 100MB.
# ──────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────
# 'development' | 'production'. Production fails-closed on missing libmagic
# and stricter cookie semantics; development is more permissive.
APP_ENV=development

# REQUIRED. Signs every JWT token the app issues. Generate once with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Anyone who reads this string can forge a token for any user → admin
# takeover. Never commit, never paste in chat, rotate if leaked.
SECRET_KEY=your-secret-key-here

# JSON array of frontend origins allowed to call this API. Strict — no '*'.
# The refresh cookie uses SameSite=None; Secure → must be HTTPS in prod.
CORS_ORIGINS=["http://localhost:5173","https://drive.lumina.aipower.vn"]


# ── Database (PostgreSQL) ─────────────────────────────────────────────────
# REQUIRED. Connection pool: 20 + 30 overflow, pre_ping, recycle 1h.
# DBA must run `CREATE EXTENSION IF NOT EXISTS unaccent;` once before first
# `alembic upgrade head` if app user lacks superuser permission.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lumina_driver_dev
DB_USER=postgres
DB_PASSWORD=your-password-here


# ── Redis (cache + ARQ job queue) ─────────────────────────────────────────
# REQUIRED. Compose starts redis with AOF persistence (everysec fsync) so
# pending jobs survive restart with ≤1s data loss.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=


# ── Qdrant (vector DB) ────────────────────────────────────────────────────
# REQUIRED. Run separately or as a managed service.
# QDRANT_VECTOR_SIZE must match the embedding model admin configures
# (text-embedding-3-large = 3072, text-embedding-3-small = 1536).
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=document_chunks
QDRANT_VECTOR_SIZE=3072


# ── Document conversion ───────────────────────────────────────────────────
# Gotenberg service for office → PDF conversion.
# - Local dev (uvicorn trực tiếp): set tới Gotenberg đang chạy (vd: localhost:3000)
# - Docker compose deploy: compose override thành http://gotenberg:3000, giá trị này bị ignore
GOTENBERG_URL=http://localhost:3000


# ── Langfuse (LLM observability, optional) ────────────────────────────────
# Self-hosted or cloud. Skip if not tracing LLM calls.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ── Lumina SSO (Centralized) ─────────────────────────────────────────────────
LUMINA_SSO_SERVICE_URL=


# ── Microsoft Entra (OBO path từ lumina-backend) ─────────────────────────────
# Khi lumina-backend dùng OBO để lấy Driver API token, driver sẽ verify token
# đó offline qua JWKS của Microsoft. Để trống để tắt (chỉ dùng SSO + local JWT).
#
# ENTRA_TENANT_ID        : Directory (tenant) ID — lấy ở Entra ID → Overview
# ENTRA_DRIVER_API_AUDIENCE : Application ID URI của Driver API app registration
#                             (thường là api://<Application ID>)
ENTRA_TENANT_ID=
ENTRA_DRIVER_API_AUDIENCE=api://<driver-api-client-id>
ENTRA_JWKS_CACHE_SECONDS=3600