FROM node:22-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG VITE_API_PREFIX=http://localhost:1690/api/v1
ARG VITE_SSO_SERVICE_URL=http://localhost:3100
ARG VITE_SSO_AUTO_REDIRECT=false
ARG VITE_SSO_APP=storage
ARG VITE_ENTRA_STORAGE_FE_CLIENT_ID=
ARG VITE_ENTRA_TENANT_ID=common
ARG VITE_ENTRA_STORAGE_API_SCOPE=
ARG VITE_ENTRA_REDIRECT_URI=http://localhost:5174/auth/microsoft/popup
ARG VITE_CORE_ORIGIN=http://localhost:5173

ENV VITE_API_PREFIX=$VITE_API_PREFIX
ENV VITE_SSO_SERVICE_URL=$VITE_SSO_SERVICE_URL
ENV VITE_SSO_AUTO_REDIRECT=$VITE_SSO_AUTO_REDIRECT
ENV VITE_SSO_APP=$VITE_SSO_APP
ENV VITE_ENTRA_STORAGE_FE_CLIENT_ID=$VITE_ENTRA_STORAGE_FE_CLIENT_ID
ENV VITE_ENTRA_TENANT_ID=$VITE_ENTRA_TENANT_ID
ENV VITE_ENTRA_STORAGE_API_SCOPE=$VITE_ENTRA_STORAGE_API_SCOPE
ENV VITE_ENTRA_REDIRECT_URI=$VITE_ENTRA_REDIRECT_URI
ENV VITE_CORE_ORIGIN=$VITE_CORE_ORIGIN

RUN npm run build

FROM nginx:1.27-alpine AS runtime

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80
