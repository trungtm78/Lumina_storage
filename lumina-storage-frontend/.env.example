VITE_API_PREFIX=https://drive-api.lumina.aipower.vn/api/v1
VITE_SSO_SERVICE_URL=http://localhost:3100
VITE_SSO_AUTO_REDIRECT=true

# Microsoft Entra ID (Azure AD) — Storage FE app registration
# Leave blank to disable Microsoft login
VITE_ENTRA_STORAGE_FE_CLIENT_ID=
VITE_ENTRA_TENANT_ID=common
# Scope exposed by the Storage backend API app registration
VITE_ENTRA_STORAGE_API_SCOPE=api://<storage-api-client-id>/Storage.Access
# Must be registered as a redirect URI in the app registration (type: Single-Page Application)
VITE_ENTRA_REDIRECT_URI=http://localhost:5174/auth/microsoft/popup

# Core FE origin — used to load the /logout-bridge iframe during global logout.
# Microsoft sign-in takes precedence: if an MSAL session exists, both apps sign in
# automatically. Local/SSO login is only reachable after a global Microsoft logout.
VITE_CORE_ORIGIN=http://localhost:5173
